<launch>
  <gz_server
    world_sdf_file="$(find-pkg-share warehouse)/worlds/warehouse.sdf"
    use_composition="False"/>
  <ros_gz_bridge
    bridge_name="ros_gz_bridge"
    config_file="$(find-pkg-share warehouse)/config/bridge.yaml"
    use_composition="False">
    <param from="$(find-pkg-share warehouse)/config/config.yaml" />
  </ros_gz_bridge>
  <timer period="25.0">
    <node pkg="warehouse" exec="warehouse_route_controller"
          name="warehouse_route_controller" output="screen">
      <param from="$(find-pkg-share warehouse)/config/config.yaml" />
    </node>
  </timer>
  <executable cmd="gz sim -g" output="screen" />
</launch>
