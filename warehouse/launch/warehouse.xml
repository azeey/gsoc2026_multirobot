<launch>
  <gz_server
    world_sdf_file="$(find-pkg-share warehouse)/worlds/warehouse.sdf"
    use_composition="False"/>
  <ros_gz_bridge
    bridge_name="ros_gz_bridge"
    config_file="$(find-pkg-share warehouse)/config/bridge.yaml"
    use_composition="False">
    <param name="automated_bridge.enable" value="true" />
    <param name="automated_bridge.exclude_patterns"
           value="['/clock', '.*camera.*', '.*tf']" />
  </ros_gz_bridge>
  <executable cmd="gz sim -g" output="screen" />
</launch>
